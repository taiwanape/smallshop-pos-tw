{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "daily-tools",
  "main": "worker/index.ts",
  "compatibility_date": "2026-05-15",
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "directory": "./dist-cloudflare",
    "binding": "ASSETS",
    "not_found_handling": "none",
    "run_worker_first": ["/api", "/api/*"],
  },
  "observability": { "enabled": false },
}
